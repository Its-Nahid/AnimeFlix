# ==========================================
# AnimeFlix .gitignore
# ==========================================

# Dependencies
node_modules

# Build output
dist
dist-ssr

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local-only files
*.local

# Proxy server (contains upstream URLs, spoofing headers, API routing logic)
# proxy.cjs

# Large binary / media test files
segment.ts
*.ts.bak

# Derived AniList enrichment cache (rebuilt at runtime from AniList API)
anilist_cache.json

# Temporary API backend source (separate repo)
temp-api/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.claude
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
